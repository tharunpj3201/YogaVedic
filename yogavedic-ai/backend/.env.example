PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/yogavedic
# REQUIRED: secret used to sign login tokens (JWT). The server refuses to start
# if this is missing, shorter than 32 characters, or still a placeholder.
# Generate a strong random value locally and paste it below (never commit it):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   (or: openssl rand -hex 48)
JWT_SECRET=<generate-a-random-secret>
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Powers the in-app AI Chat Assistant (floating chat button). Get a key at
# https://platform.openai.com/api-keys — if left unset, the assistant
# automatically falls back to its offline rule-based replies.
OPENAI_API_KEY=sk-your-key-here
