# .dockerignore for the backend build context (./backend).
# Docker patterns are matched from the context root, so "**/" is used
# to match at any depth. The Dockerfile needs package*.json and src/.

# Environment files - never bake local secrets into an image
**/.env
**/.env.*
**/*.env

# Version control
**/.git
**/.gitignore

# Dependencies (installed fresh by `npm ci` inside the image)
**/node_modules

# Build output, caches, coverage
**/dist
**/build
**/coverage
**/.nyc_output
**/.cache
**/.eslintcache

# Logs
**/logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Private keys and certificates
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_rsa.*
**/id_ed25519
**/id_ed25519.*

# OS / editor metadata and temporary files
**/.DS_Store
**/._*
**/Thumbs.db
**/Desktop.ini
**/.idea
**/.vscode
**/*.swp
**/*.swo
**/*~
**/*.tmp
**/*.temp
